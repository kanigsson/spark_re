with "spark_re.gpr";
with "common/spark_cli/spark_cli.gpr";
project Tools is
   for Source_Dirs use ("cli", "tests");
   for Object_Dir use "obj/" & Spark_Re.Build & "/tools";
   case Spark_Re.Build is
      when "release" => for Exec_Dir use "bin";
      when "checks" => for Exec_Dir use "bin/checks";
   end case;
   for Main use ("spark_grep.adb", "spark_rg.adb", "test_regex.adb", "test_matcher.adb");
   package Builder is
      for Executable ("spark_grep.adb") use "spark-grep";
      for Executable ("spark_rg.adb") use "spark-rg";
   end Builder;
   package Compiler is
      --  Assertions are a property of the build mode, not of the CLI sources.
      case Spark_Re.Build is
         when "release" =>
            for Default_Switches ("Ada") use ("-gnat2022", "-gnatwa", "-O2");
         when "checks" =>
            for Default_Switches ("Ada") use ("-gnat2022", "-gnatwa", "-gnata", "-O2");
      end case;
   end Compiler;
end Tools;
